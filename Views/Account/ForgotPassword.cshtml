@model HoangHaPCVN.Models.ViewModel.ForgotPasswordVM
@{
    ViewBag.Title = "Quên mật khẩu";
}

@section styles {
    <link href="~/Content/Account.css" rel="stylesheet" />
}

<div class="account-page">
    <div class="account-box account-box-wide">
        <h1>Quên mật khẩu</h1>
        <p class="auth-sub">Nhập đúng thông tin lúc đăng ký để đặt mật khẩu mới.</p>

        @using (Html.BeginForm("ForgotPassword", "Account", new { area = "" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)

            <div class="auth-field">
                @Html.LabelFor(m => m.Username, new { @class = "account-label" })
                @Html.TextBoxFor(m => m.Username, new { maxlength = "30", autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.Username)
            </div>

            <div class="auth-row">
                <div class="auth-field">
                    @Html.LabelFor(m => m.CustomerPhone, new { @class = "account-label" })
                    @Html.TextBoxFor(m => m.CustomerPhone, new { type = "tel", maxlength = "10", autocomplete = "tel" })
                    @Html.ValidationMessageFor(m => m.CustomerPhone)
                </div>
                <div class="auth-field">
                    @Html.LabelFor(m => m.CustomerEmail, new { @class = "account-label" })
                    @Html.TextBoxFor(m => m.CustomerEmail, new { type = "email", autocomplete = "email" })
                    @Html.ValidationMessageFor(m => m.CustomerEmail)
                </div>
            </div>

            <div class="auth-row">
                <div class="auth-field">
                    @Html.LabelFor(m => m.NewPassword, new { @class = "account-label" })
                    @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.NewPassword)
                </div>
                <div class="auth-field">
                    @Html.LabelFor(m => m.ConfirmNewPassword, new { @class = "account-label" })
                    @Html.PasswordFor(m => m.ConfirmNewPassword, new { autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmNewPassword)
                </div>
            </div>

            <button type="submit" class="auth-submit">Đặt lại mật khẩu</button>
        }

        <p class="auth-sub account-forgot">
            Nhớ ra mật khẩu? <a href="@Url.Action("Login", "Account", new { area = "" })" class="auth-link">Đăng nhập</a>
        </p>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}