@model HoangHaPCVN.Models.ViewModel.ChangePasswordVM

@using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="account-form-row">
        @Html.LabelFor(m => m.OldPassword, new { @class = "account-label" })
        @Html.PasswordFor(m => m.OldPassword, new { @class = "account-input", autocomplete = "current-password" })
        @Html.ValidationMessageFor(m => m.OldPassword)
    </div>
    <div class="account-form-row">
        @Html.LabelFor(m => m.NewPassword, new { @class = "account-label" })
        @Html.PasswordFor(m => m.NewPassword, new { @class = "account-input", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.NewPassword)
    </div>
    <div class="account-form-row">
        @Html.LabelFor(m => m.ConfirmNewPassword, new { @class = "account-label" })
        @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "account-input", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.ConfirmNewPassword)
    </div>
    <button type="submit" class="account-btn">Đổi mật khẩu</button>
}