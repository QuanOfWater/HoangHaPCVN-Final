@model HoangHaPCVN.Models.ViewModel.HomeProductVM

@{
    ViewBag.Title = "Trang chủ";
    bool dangTimKiem = !string.IsNullOrEmpty(Model.SearchTerm);
}

@section styles {
    <link href="~/Content/home.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" />
}

@if (dangTimKiem)
{
    //Hiện dòng kết quả khi đang tìm kiếm
    <div class="search-result">
        Kết quả tìm kiếm cho "<strong>@Model.SearchTerm</strong>": tìm thấy <strong>@Model.SoKetQua</strong> sản phẩm.
        @Html.ActionLink("Xóa tìm kiếm", "Index", "Home", new { area = "" }, null)
    </div>
}
else
{
    //Slidebar danh mục + banner
    <div class="main-container">

        @* Cột menu bên trái (dữ liệu lấy từ DB) *@
        @Html.Action("CategoriesMenu", "Home", new { area = "" })

        @* Banner chính *@
        <section class="banner-area">
            <div class="main-slider">
                <a href="#" class="slide active"><img src="~/Content/img/HINHBUNHAT.png" alt="Chính sách bảo hành cả cháy nổ"></a>
            </div>
            <div class="right-banners">
                <a href="#" class="banner-item"><img src="~/Content/img/BHTN.png" alt="Bảo hành tận nhà"></a>
                <a href="#" class="banner-item"><img src="~/Content/img/VSMT.png" alt="Vệ sinh máy tính"></a>
            </div>
            <a href="#" class="banner-item bottom-banner"><img src="~/Content/img/PCAI.png" alt="PC chuyên AI Training"></a>
            <a href="#" class="banner-item bottom-banner"><img src="~/Content/img/PCTHIETKE.png" alt="PC thiết kế đồ họa 3D"></a>
            <a href="#" class="banner-item bottom-banner"><img src="~/Content/img/PCEDIT.png" alt="PC edit video render"></a>
        </section>
    </div>
}

@* Sản phẩm bán chạy (slide: Sản phẩm nổi bật) *@
@Html.Partial("_PVFeatureProduct", Model)

@* Danh sách sản phẩm mới (slide: Danh sách sản phẩm) *@
@Html.Partial("_PVNewProduct", Model)

@if (!dangTimKiem)
{
    
    <section class="banner-section">
        <a href="#" class="banner-big">
            <img src="~/Content/img/HinhBu.png" alt="PC Video Editing">
        </a>
    </section>

    //Mỗi danh mục một khối SP
    foreach (var sec in Model.CategoriesSections)
    {
        string linkDanhMuc = Url.Action("ProductList", "Home", new { area = "", id = sec.CategoryID });

        <section class="ps-section">
            <div class="ps-head">
                <a href="@linkDanhMuc" class="ps-title">@sec.CategoryName</a>
                <a href="@linkDanhMuc" class="ps-more">Xem tất cả ›</a>
            </div>
            <div class="ps-grid">
                @foreach (var p in sec.Products)
                {
                    @Html.Partial("_PVProductCard", p)
                }
            </div>
        </section>
    }
}