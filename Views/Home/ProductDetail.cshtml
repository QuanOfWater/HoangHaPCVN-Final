@model HoangHaPCVN.Models.ViewModel.ProductDetailVM

@{
    ViewBag.Title = Model.Product.ProductName;
    var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string anh = string.IsNullOrEmpty(Model.Product.ProductImage)
        ? "~/Content/images/default_img.png"
        : Model.Product.ProductImage;
    string linkDanhMuc = Url.Action("ProductList", "Home", new { area = "", id = Model.Product.CategoryID });
    bool hetHang = Model.Product.Quantity < 1;
    int toiDa = Math.Max(1, Math.Min(HoangHaPCVN.Models.ViewModel.Cart.MaxQuantity, Model.Product.Quantity));
}

@section styles {
    <link href="~/Content/home.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" />
    <link href="~/Content/productlist.css" rel="stylesheet" />
    <link href="~/Content/productdetail.css" rel="stylesheet" />
}

@* Breadcrumb *@
<div class="breadcrumb-bar">
    <a href="@Url.Action("Index", "Home", new { area = "" })"><i class="fa-solid fa-house"></i> Trang chủ</a>
    <span class="sep">›</span>
    <a href="@linkDanhMuc">@Model.Product.Category.CategoryName</a>
    <span class="sep">›</span>
    <span>@Model.Product.ProductName</span>
</div>

<div class="pd-layout">

    @* Khối bên trái: ảnh sản phẩm *@
    <div class="pd-box pd-image">
        <img src="@Url.Content(anh)" alt="@Model.Product.ProductName" />
    </div>

    @* Khối ở giữa: thông tin sản phẩm + sản phẩm tương tự *@
    <div class="pd-box">
        <h1 class="pd-name">@Model.Product.ProductName</h1>

        <div class="pd-meta">
            @if (hetHang)
            {
                <span class="pd-stock-out">Hết hàng</span>
            }
            else
            {
                <span>Còn lại: <strong class="pd-stock-ok">@Model.Product.Quantity</strong></span>
            }
            <span>Đã bán: <strong>@Model.SoLuongDaBan</strong></span>
            <span>Danh mục: <a href="@linkDanhMuc">@Model.Product.Category.CategoryName</a></span>
        </div>

        <div class="pd-price">@Model.Product.ProductPrice.ToString("N0", vn) đ</div>

        <h3 class="pd-section-title">Mô tả sản phẩm</h3>
        <div class="pd-desc">@Model.Product.ProductDescription</div>

        @* Khối Sản phẩm tương tự *@
        @Html.Partial("_PVRelatedProduct", Model)
    </div>

    @* Khối bên phải: phần chọn mua + bán chạy cùng danh mục *@
<div class="pd-side">
    <div class="pd-box pd-buy">
        @if (hetHang)
        {
            <p class="pd-out">Sản phẩm tạm hết hàng</p>
            <p>Vui lòng quay lại sau hoặc xem các sản phẩm tương tự.</p>
        }
        else
        {
            @* Phần tạm tính.
            Có JavaScript: bấm - / + hoặc gõ số là tạm tính đổi ngay.
            Không có JavaScript: bấm "Cập nhật" để tải lại trang và tính lại. *@
            <form method="get" action="@Url.Action("ProductDetail", "Home", new { area = "", id = Model.Product.ProductID })">
                <label for="quantity">Số lượng</label>
                <div class="pd-qty">
                    <button type="button" class="pd-qty-btn" id="btnGiam" aria-label="Giảm số lượng" hidden>−</button>
                    <input type="number" id="quantity" name="quantity" value="@Model.Quantity" min="1" max="@toiDa" />
                    <button type="button" class="pd-qty-btn" id="btnTang" aria-label="Tăng số lượng" hidden>+</button>
                    <button type="submit" class="pd-btn-outline" id="btnCapNhat">Cập nhật</button>
                </div>
            </form>

            <div class="pd-subtotal">
                Tạm tính: <strong id="tamTinh">@Model.EstimatedValue.ToString("N0", vn) đ</strong>
            </div>

            @* Thêm vào giỏ hàng: gửi mã sản phẩm và số lượng sang CartController *@
            <form method="post" action="@Url.Action("AddToCart", "Cart", new { area = "" })">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Product.ProductID" />
                <input type="hidden" id="qtyHidden" name="quantity" value="@Model.Quantity" />
                <button type="submit" class="pd-btn-primary">
                    <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng
                </button>
            </form>
        }
    </div>

    @* Khối Top Deals: bán chạy cùng danh mục *@
    @Html.Partial("_PVTopProduct", Model)
</div>
</div>

@section scripts {
    <script>
        //Phần chọn mua: nút - / +, tạm tính đổi ngay khi đổi số lượng
        (function () {
            //Đổi số thập phân sang số nguyên
            var gia = @((long)Model.Product.ProductPrice);

            var oSoLuong   = document.getElementById('quantity'); //Ô để nhập số lượng
            var tamTinh    = document.getElementById('tamTinh'); //Tạm tính
            var oAn        = document.getElementById('qtyHidden'); //Ô ẩn gửi sang giỏ hàng
            var btnGiam    = document.getElementById('btnGiam');
            var btnTang    = document.getElementById('btnTang');
            var btnCapNhat = document.getElementById('btnCapNhat');
                        if (!oSoLuong) {
                return; //Hết hàng: không có ô số lượng thì không làm gì
            }
            var toiDa = @toiDa; //Tồn kho (tối đa 99)

            //Hiện nút + / -
            btnGiam.hidden = false;
            btnTang.hidden = false;
            btnCapNhat.hidden = true;

            //Đọc số lượng trong ô, luôn trả về số từ 1 đến 99
            function laySoLuong() {
                var soLuong = parseInt(oSoLuong.value, 10);
                if (isNaN(soLuong) || soLuong < 1) { soLuong = 1; }
                if (soLuong > toiDa) { soLuong = toiDa; }
                return soLuong;
            }

            //Tính lại tạm tính và cập nhật số lượng sẽ gửi sang giỏ hàng
            function capNhatTamTinh() {
                var soLuong = laySoLuong();
                tamTinh.textContent = (soLuong * gia).toLocaleString('vi-VN') + ' đ';
                oAn.value = soLuong;
            }

            //Đang gõ: tính lại ngay
            oSoLuong.addEventListener('input', capNhatTamTinh);

            //Gõ xong rời ô: sửa lại số không hợp lệ (ví dụ 0, 150, chữ) cho đúng
            oSoLuong.addEventListener('change', function () {
                oSoLuong.value = laySoLuong();
                capNhatTamTinh();
            });

            //Nút giảm, nút tăng
            btnGiam.addEventListener('click', function () {
                oSoLuong.value = Math.max(1, laySoLuong() - 1);
                capNhatTamTinh();
            });
            btnTang.addEventListener('click', function() {
                oSoLuong.value = Math.min(toiDa, laySoLuong() + 1)
                capNhatTamTinh();
            });
        })();
    </script>
}