@model HoangHaPCVN.Models.ViewModel.Cart

@{
    ViewBag.Title = "Giỏ hàng";
    var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

@section styles {
    <link href="~/Content/home.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" />
    <link href="~/Content/productlist.css" rel="stylesheet" />
    <link href="~/Content/cart.css" rel="stylesheet" />
}

<div class="breadcrumb-bar">
    <a href="@Url.Action("Index", "Home", new { area = "" })"><i class="fa-solid fa-house"></i> Trang chủ</a>
    <span class="sep">›</span>
    <span>Giỏ hàng</span>
</div>

<h1 class="cart-title">Giỏ hàng của bạn</h1>

@if (TempData["CartMessage"] != null)
{
    <div class="cart-alert"><i class="fa-solid fa-circle-check"></i> @TempData["CartMessage"]</div>
}

@if (ViewBag.StockMessage != null)
{
    <div class="cart-alert cart-alert-warn"><i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.StockMessage</div>
}

@if (!Model.Items.Any())
{
    <div class="cart-empty">
        <i class="fa-solid fa-cart-shopping"></i>
        <p>Bạn chưa có sản phẩm nào trong giỏ.</p>
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="cart-btn-continue">Tiếp tục mua hàng</a>
    </div>
}
else
{
    <div class="cart-layout">

        @* Chi tiết giỏ hàng *@
        <div class="cart-main">

            @* Ô "Chọn tất cả" *@
            <label class="cart-select-all" id="lblChonTatCa" hidden>
                <input type="checkbox" id="chkAll" checked /> Chọn tất cả
            </label>

            @foreach (var group in Model.GroupedItems)
            {
                <div class="cart-group">
                    <h3 class="cart-group-title">@group.Key</h3>

                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th class="col-chk"></th>
                                <th colspan="2">Sản phẩm</th>
                                <th class="col-qty">Số lượng</th>
                                <th class="col-money">Đơn giá</th>
                                <th class="col-money">Thành tiền</th>
                                <th class="col-del"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group)
                            {
                                string anh = string.IsNullOrEmpty(item.ProductImage)
                                    ? "~/Content/images/default_img.png"
                                    : item.ProductImage;
                                bool hetHang = item.Stock < 1;
                                int toiDa = Math.Max(1, Math.Min(HoangHaPCVN.Models.ViewModel.Cart.MaxQuantity, item.Stock));

                                @* data-total, data-qty: Tính tổng các SP được chọn *@
                                <tr data-total="@((long)item.TotalPrice)" data-qty="@item.Quantity" class="@(hetHang ? "cart-row-out" : null)">
                                    <td class="col-chk">
                                        @* form="frmCheckout": Ô tick thuộc form Mua hàng ở cột bên phải *@
                                        <input type="checkbox" class="chk-item" name="ids"
                                               value="@item.ProductID" form="frmCheckout" checked="@(!hetHang)" disabled="@hetHang"
                                               aria-label="Chọn mua @item.ProductName" />
                                    </td>
                                    <td class="col-img">
                                        <img src="@Url.Content(anh)" alt="@item.ProductName" />
                                    </td>
                                    <td>
                                        <a href="@Url.Action("ProductDetail", "Home", new { area = "", id = item.ProductID })" class="cart-name">
                                            @item.ProductName
                                        </a>

                                        @if (hetHang)
                                        {
                                            <div class="cart-stock out">Hết hàng</div>
                                        }
                                        else
                                        {
                                            <div class="cart-stock">Còn @item.Stock sản phẩm</div>
                                        }

                                    </td>
                                    <td class="col-qty">
                                        @* Nút - / + là nút gửi form *@
                                        @using (Html.BeginForm("UpdateQuantity", "Cart", new { area = "" }, FormMethod.Post, new { @class = "cart-qty" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ProductID" />
                                            <button type="submit" name="change" value="-1" aria-label="Giảm">−</button>
                                            <input type="number" name="quantity" class="qty-input"
                                                   value="@item.Quantity" min="1" max="@toiDa" aria-label="Số lượng" />
                                            <button type="submit" name="change" value="1" aria-label="Tăng" disabled="@(item.Quantity >= toiDa)">+</button>
                                        }
                                    </td>
                                    <td class="col-money">@item.UnitPrice.ToString("N0", vn) đ</td>
                                    <td class="col-money cart-line-total">@item.TotalPrice.ToString("N0", vn) đ</td>
                                    <td class="col-del">
                                        @using (Html.BeginForm("RemoveFromCart", "Cart", new { area = "" }, FormMethod.Post,
                                            new { data_confirm = "Xóa sản phẩm này khỏi giỏ hàng?" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ProductID" />
                                            <button type="submit" class="cart-btn-del" title="Xóa sản phẩm">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @using (Html.BeginForm("ClearCart", "Cart", new { area = "" }, FormMethod.Post,
                new { data_confirm = "Xóa TOÀN BỘ sản phẩm trong giỏ hàng?" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="cart-btn-clear"><i class="fa-solid fa-trash-can"></i> Xóa hết giỏ hàng</button>
            }
        </div>

        @* Tính tiền *@
        <aside class="cart-summary">
            <div class="cart-sum-row">
                Đã chọn: <strong id="soDaChon">@Model.TotalQuantity()</strong> sản phẩm
            </div>
            <div class="cart-sum-total">
                Tổng tiền: <strong id="tongTien">@Model.TotalValue().ToString("N0", vn) đ</strong>
            </div>

            @* Mua hàng: Gửi mã các sản phẩm đã tick sang trang Thanh toán *@
            <form id="frmCheckout" method="get" action="@Url.Action("Checkout", "Order", new { area = "" })">
                <button type="submit" class="cart-btn-buy" id="btnMuaHang">Mua hàng</button>
            </form>

            <a href="@Url.Action("Index", "Home", new { area = "" })" class="cart-btn-continue">Tiếp tục mua hàng</a>
        </aside>
    </div>

    @* Phần sản phẩm tương tự *@
    @Html.Partial("_PVSimilarProduct", Model)
}

@section scripts {
    <script>
        //Tick chọn mua, tính lại tổng tiền, tự cập nhật số lượng, hỏi xác nhận khi xóa
        (function () {
            var tongTien = document.getElementById('tongTien');
            if (!tongTien) {
                return; //Giỏ hàng trống thì không làm gì
            }

            var soDaChon = document.getElementById('soDaChon');
            var btnMua = document.getElementById('btnMuaHang');
            var chkAll = document.getElementById('chkAll');
            var lblChonTatCa = document.getElementById('lblChonTatCa');
            var chkItems = document.querySelectorAll('.chk-item:not(:disabled)'); //Bỏ qua sản phẩm hết hàng

            //Ô chọn tất cả
            lblChonTatCa.hidden = false;

            //Tính lại tổng tiền và số lượng theo các sản phẩm đang được tick
            function tinhLai() {
                var tong = 0, soLuong = 0, soDongChon = 0;
                chkItems.forEach(function (chk) {
                    if (chk.checked) {
                        var dong = chk.closest('tr');
                        tong += parseInt(dong.dataset.total, 10);
                        soLuong += parseInt(dong.dataset.qty, 10);
                        soDongChon++;
                    }
                });
                tongTien.textContent = tong.toLocaleString('vi-VN') + ' đ';
                soDaChon.textContent = soLuong;

                //Không chọn sản phẩm nào thì chặn không cho bấm Mua hàng
                btnMua.disabled = (soDongChon === 0);

                //Ô "Chọn tất cả" được tick khi mọi sản phẩm đều được chọn
                chkAll.checked = (soDongChon === chkItems.length);
            }

            chkItems.forEach(function (chk) {
                chk.addEventListener('change', tinhLai);
            });

            chkAll.addEventListener('change', function () {
                chkItems.forEach(function (chk) { chk.checked = chkAll.checked; });
                tinhLai();
            });

            //Gõ số lượng xong (rời khỏi ô) thì tự gửi form cập nhật
            document.querySelectorAll('.qty-input').forEach(function (input) {
                input.addEventListener('change', function () {
                    input.form.submit();
                });
            });

            //Hỏi xác nhận trước khi xóa (các form có thuộc tính data-confirm)
            document.querySelectorAll('form[data-confirm]').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (!confirm(form.dataset.confirm)) {
                        e.preventDefault(); //Bấm Hủy thì không gửi form
                    }
                });
            });

            tinhLai();
        })();
    </script>
}