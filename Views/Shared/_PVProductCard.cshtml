@model HoangHaPCVN.Models.Product

@{ 
    //Ảnh: Chưa có thì dùng ảnh mặc định
    string anh = string.IsNullOrEmpty(Model.ProductImage)
        ? "~/Content/images/default_img.png"
        : Model.ProductImage;

    //Tổng số lượng đã bán = cộng só lượng ở các dòng chi tiết đơn hàng
    int daBan = Model.DaBan; //Không tính đơn đã hủy

    //Format theo định dạng VND
    var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    //Link sang trang chi tiết SP
    string linkChiTiet = Url.Action("ProductDetail", "Home", new { area = "", id = Model.ProductID });

    <div class="ps-card">
        <a href="@linkChiTiet" class="ps-thumb">
            <img src="@Url.Content(anh)" alt="@Model.ProductName" />
        </a>
        <div class="ps-price">@Model.ProductPrice.ToString("N0", vn) đ</div>
        <a href="@linkChiTiet" class="ps-name">@Model.ProductName</a>
        <div class="ps-foot">
            <span class="ps-stock">Đã bán: @daBan</span>

            @* Thêm 1 sản phẩm vào giỏ hàng *@
            <form action="@Url.Action("AddToCart", "Cart", new { area = "" })" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductID" />
                <input type="hidden" name="quantity" value="1" />
                <button type="submit" class="ps-add" title="Thêm vào giỏ hàng">+</button>
            </form>
        </div>
    </div>
}

