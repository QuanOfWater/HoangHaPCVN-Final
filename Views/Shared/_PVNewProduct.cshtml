@model HoangHaPCVN.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

@* SP mới (20 SP, 6 SP mỗi trang) *@
<section class="ps-section" id="san-pham-moi">
    <div class="ps-head">
        <span class="ps-title">Sản phẩm mới</span>
    </div>

    @if (Model.NewProducts.Any())
    {
        <div class="ps-grid">
            @foreach (var p in Model.NewProducts)
            {
                @Html.Partial("_PVProductCard", p)
            }
        </div>

        <div class="pager-wrap">
            @Html.PagedListPager(Model.NewProducts, page =>
                Url.Action("Index", "Home", new { area = "", page, searchTerm = Model.SearchTerm }) + "#san-pham-moi")
        </div>
    }
    else
    {
        <p class="empty-note">Không tìm thấy sản phẩm phù hợp.</p>
    }
</section>
