@model HoangHaPCVN.Models.ViewModel.LoginVM

@{
    Layout = null;
    string returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập trang quản trị - HoangHaPC</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />
    <link rel="stylesheet" href="~/Content/AdminLogin.css" />
</head>
<body class="admin-login-page">
    <div class="al-card">
        @* ===== Logo + tên trang ===== *@
        <div class="al-brand">
            <div class="al-logo-icon">
                <img src="~/Content/img/LogoHHPC.png" alt="HoangHaPC" />
            </div>
            <span class="al-brand-name">HoangHaPC Admin</span>
        </div>

        <h1 class="al-title">Đăng nhập để tiếp tục</h1>

        @using (Html.BeginForm("Login", "Account", new { returnUrl = returnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "al-alert" })

            <div class="al-field">
                @Html.LabelFor(m => m.Username)
                <div class="al-input-wrap">
                    <i class="fa-regular fa-circle-user"></i>
                    @Html.TextBoxFor(m => m.Username, new
                    {
                        @class = "al-input",
                        autofocus = "autofocus",
                        autocomplete = "username",
                        placeholder = "Tên đăng nhập"
                    })
                </div>
                @Html.ValidationMessageFor(m => m.Username)
            </div>

            <div class="al-field">
                @Html.LabelFor(m => m.Password)
                <div class="al-input-wrap">
                    <i class="fa-solid fa-key"></i>
                    @Html.PasswordFor(m => m.Password, new
                    {
                        @class = "al-input",
                        autocomplete = "current-password",
                        placeholder = "Mật khẩu"
                    })
                    <button type="button" class="al-toggle-pass" aria-label="Hiện mật khẩu">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.Password)
            </div>

            <button type="submit" class="al-submit">Đăng nhập</button>
        }
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        //Bấm icon con mắt để hiện / ẩn mật khẩu
        document.querySelector('.al-toggle-pass').addEventListener('click', function () {
            var input = document.getElementById('Password');
            var icon = this.querySelector('i');
            var dangAn = input.type === 'password';
            input.type = dangAn ? 'text' : 'password';
            icon.className = dangAn ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            this.setAttribute('aria-label', dangAn ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
        });
    </script>
</body>
</html>