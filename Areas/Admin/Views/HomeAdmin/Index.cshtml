@model HoangHaPCVN.Models.ViewModel.DashBoardVM

@{
    ViewBag.Title = "Tổng quan";
}

<div class="ad-page-head">
    <div>
        <h1>Tổng quan</h1>
        <p>Số liệu cập nhật lúc @DateTime.Now.ToString("HH:mm, dd/MM/yyyy")</p>
    </div>
</div>

@* 4 ô số liệu, bấm vào ô nào thì mở danh sách tương ứng *@
<div class="ad-stats">
    <a class="ad-stat" href="@Url.Action("Index", "Products")">
        <span class="ad-stat-label">Sản phẩm</span>
        <span class="ad-stat-value">@Model.TongSanPham</span>
        <span class="ad-stat-link">Xem danh sách →</span>
    </a>
    <a class="ad-stat" href="@Url.Action("Index", "Categories")">
        <span class="ad-stat-label">Danh mục</span>
        <span class="ad-stat-value">@Model.TongDanhMuc</span>
        <span class="ad-stat-link">Xem danh sách →</span>
    </a>
    <a class="ad-stat" href="@Url.Action("Index", "Customers")">
        <span class="ad-stat-label">Khách hàng</span>
        <span class="ad-stat-value">@Model.TongKhachHang</span>
        <span class="ad-stat-link">Xem danh sách →</span>
    </a>
    <a class="ad-stat" href="@Url.Action("Index", "Orders")">
        <span class="ad-stat-label">Đơn hàng</span>
        <span class="ad-stat-value">@Model.TongDonHang</span>
        <span class="ad-stat-link">Xem danh sách →</span>
    </a>
</div>

<div class="ad-panel">
    <div class="ad-revenue">
        <span class="ad-revenue-label">Doanh thu từ các đơn đã giao</span>
        <strong>@Model.DoanhThu.ToString("N0")<small>đ</small></strong>
    </div>
</div>

@* Google Chart *@
<div class="ad-panel">
    <div class="ad-panel-head">
        Tỷ lệ sản phẩm theo danh mục
        <small>@Model.TongDanhMuc danh mục</small>
    </div>
    <div class="ad-panel-body">
        @if (Model.TongSanPham > 0)
        {
            <div class="ad-chart">
                @* Bên trái: vành khuyên, tổng số sản phẩm nằm giữa lỗ *@
                <div class="ad-donut">
                    @* Google Chart sẽ vẽ biểu đồ vào thẻ div có id="bieuDoDanhMuc" *@
                    <div id="bieuDoDanhMuc"></div>
                    <div class="ad-donut-center">
                        <strong>@Model.TongSanPham</strong>
                        <span>sản phẩm</span>
                    </div>
                </div>

                @* Bên phải: bảng chú thích, JavaScript bên dưới sẽ điền các dòng vào *@
                <table class="ad-legend">
                    <tbody id="chuThich"></tbody>
                </table>
            </div>
        }
        else
        {
            <p class="ad-empty">Chưa có sản phẩm nào để thống kê.</p>
        }
    </div>
</div>

@section scripts {
    @* Thư viện Google Chart *@
    <script src="https://www.gstatic.com/charts/loader.js"></script>

    <script>
        //Chuyển dữ liệu sang JavaScript dưới dạng JSON
        var thongKe = @Html.Raw(Json.Encode(Model.SanPhamTheoDanhMuc));

        //Bảng màu dùng chung cho miếng chart và chấm màu trong chú thích
        var mau = ['#3b82f6', '#60a5fa', '#22d3ee', '#2dd4bf', '#818cf8', '#c4b5fd', '#71717a',
                   '#f472b6', '#fbbf24', '#a3e635'];

        //Nạp gói biểu đồ cơ bản, nạp xong thì gọi hàm veBieuDo
        google.charts.load('current', { packages: ['corechart'] });
        google.charts.setOnLoadCallback(function () {
            veChuThich();
            veBieuDo();
        });

        //Tạo bảng chú thích: chấm màu + tên danh mục | số sản phẩm | phần trăm
        function veChuThich() {
            var bang = document.getElementById('chuThich');
            if (!bang) {
                return;
            }

            var tong = 0;
            for (var i = 0; i < thongKe.length; i++) {
                tong += thongKe[i].SoSanPham;
            }

            var html = '';
            for (var j = 0; j < thongKe.length; j++) {
                var phanTram = tong > 0 ? (thongKe[j].SoSanPham * 100 / tong).toFixed(1) : 0;
                var tenDanhMuc = $('<div>').text(thongKe[j].TenDanhMuc).html(); //Chống chèn HTML từ tên danh mục
                html += '<tr>'
                    + '<td><span class="dot" style="background:' + mau[j % mau.length] + '"></span>' + tenDanhMuc + '</td>'
                    + '<td class="num">' + thongKe[j].SoSanPham + '</td>'
                    + '<td class="num">' + phanTram + '%</td>'
                    + '</tr>';
            }
            bang.innerHTML = html;
        }

        function veBieuDo() {
            //Không có chỗ để vẽ (chưa có sản phẩm) thì dừng
            var khungVe = document.getElementById('bieuDoDanhMuc');
            if (!khungVe) {
                return;
            }

            //Tạo bảng dữ liệu cho biểu đồ: cột 1 là tên, cột 2 là số
            var duLieu = new google.visualization.DataTable();
            duLieu.addColumn('string', 'Danh mục');
            duLieu.addColumn('number', 'Số sản phẩm');

            //Mỗi danh mục là 1 dòng, ứng với 1 miếng của chart
            for (var i = 0; i < thongKe.length; i++) {
                duLieu.addRow([thongKe[i].TenDanhMuc, thongKe[i].SoSanPham]);
            }

            //Tùy chỉnh chart: vành khuyên phẳng trên nền tối, chú thích đã tự làm ở bảng bên cạnh
            var tuyChon = {
                pieHole: 0.74,                    //Lỗ giữa to để đặt số tổng vào
                pieSliceText: 'none',             //Không ghi % trên miếng
                pieSliceBorderColor: '#151518',   //Trùng màu nền khung để tạo khe giữa các miếng
                backgroundColor: 'transparent',
                legend: 'none',
                chartArea: { left: 0, top: 0, width: '100%', height: '100%' },
                fontName: 'Segoe UI',
                tooltip: { text: 'both' },
                colors: mau
            };

            //Vẽ chart vào thẻ div
            var bieuDo = new google.visualization.PieChart(khungVe);
            bieuDo.draw(duLieu, tuyChon);
        }
    </script>
}
